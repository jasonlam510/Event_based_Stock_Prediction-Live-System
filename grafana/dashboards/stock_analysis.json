      "id": 4,
      "options": {
        "afterRender": "",
        "content": "<div style=\"\n     display: flex;\n     align-items: flex-start;\n     padding: 8px;\n     border-bottom: 1px solid #eee;\n   \">\n  <!-- 1) Thumbnail (now on the left) -->\n  {{#if media_url}}\n  <div style=\"flex: 0 0 auto; max-width: 160px; margin-right: 12px;\">\n    <img\n      src=\"{{media_url}}\"\n      alt=\"thumbnail\"\n      style=\"width:100%; height:auto; border-radius:4px\"\n    />\n  </div>\n  {{/if}}\n\n  <!-- 2) Meta (middle now) -->\n  <div style=\"flex: 2 1 0; margin-right:16px;\">\n    <h2 style=\"margin:0; font-size:1.6em; line-height:1.2\">\n      <a href=\"{{link}}\" target=\"_blank\" style=\"color:#1f78c1; text-decoration:none\">\n        {{title}}\n      </a>\n    </h2>\n    <p style=\"margin:4px 0 0; font-size:0.9em; color:#555\">\n      {{pub_date}}\n      {{#if source_name}}\n      by\n      <a href=\"{{source_url}}\" target=\"_blank\" style=\"color:#1f78c1\">\n        {{source_name}}\n      </a>\n      {{/if}}\n    </p>\n  </div>\n\n  <!-- 3) Analysis (rightmost) -->\n  <div style=\"\n        flex: 1 1 0;\n        font-size:0.95em;\n        color:#888;\n        line-height:1.4;\n      \">\n    <div>Sentiment: {{sentiment_score}}</div>\n    <div>Relevance: {{relevance_score}}</div>\n    <div>Importance: {{event_importance}}</div>\n    <div>Final Score: {{final_score}}</div>\n    <div>Type: {{event_type}}</div>\n\n  </div>\n</div>",
        "contentPartials": [],
        "defaultContent": "The query didn't return any results.",
        "editor": {
          "format": "auto",
          "language": "html"
        },
        "editors": [],
        "externalStyles": [],
        "helpers": "",
        "renderMode": "everyRow",
        "styles": "",
        "wrap": true
      },
      "pluginVersion": "6.0.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P40AE60E18F02DE32"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  y.pub_date,\n  y.title,\n  y.link,\n  y.source_name,\n  y.source_url,\n  y.media_url,\n  a.sentiment_score,\n  a.relevance_score,\n  a.event_importance,\n  a.event_type,\n  ROUND(\n    (a.sentiment_score\n     * a.relevance_score\n     * a.event_importance\n    )::numeric\n  , 2\n  ) AS final_score\nFROM yf_rss_items AS y\nINNER JOIN analysis_results AS a\n  ON y.guid = a.guid\n  AND y.pub_date = a.pub_date\nWHERE\n  -- last 24h\n  y.pub_date >= NOW() - INTERVAL '24 HOURS'\n  -- filter event_type via dashboard variable:\n  AND a.event_type IN ($eventType)\nORDER BY ${sortBy:raw} DESC\nLIMIT 100;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Last 24hr US news",
      "transformations": [
        {
          "id": "formatTime",
          "options": {
            "outputFormat": "YYYY-MM-DD HH:MM",
            "timeField": "pub_date",
            "timezone": "browser",
            "useTimezone": true
          }
        }
      ],
